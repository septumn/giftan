{
  "$schema": "https://schemastore.org",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": false,
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "tsconfig-paths",
        "options": {
          "tsconfig": "tsconfig.json"
        }
      }
    ]
  }
}
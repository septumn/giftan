# AS base
FROM node:22-alpine AS base
WORKDIR /app

# AS deps
FROM base AS deps
COPY package*.json ./
COPY apps/backend/package.json ./apps/backend/
COPY packages/shared/package.json ./packages/shared/

RUN npm ci

# AS builder
FROM base AS builder
COPY --from=deps app/node_modules ./node_modules
COPY package.json ./
COPY apps/backend ./apps/backend
COPY packages/shared ./packages/shared

RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=apps/backend

RUN npm prune --omit=dev --workspace=apps/backend

# AS runner
FROM base AS runner
ENV NODE_ENV=production

USER node

# common
COPY --from=builder --chown=node:node app/node_modules ./node_modules/

# apps/backend
COPY --from=builder --chown=node:node app/apps/backend/package.json ./apps/backend/
COPY --from=builder --chown=node:node app/apps/backend/dist ./apps/backend/dist/
COPY --from=builder --chown=node:node app/apps/backend/drizzle ./apps/backend/drizzle/
COPY --from=builder --chown=node:node app/apps/backend/src/schema.gql ./apps/backend/src/

# packages/shared
COPY --from=builder --chown=node:node app/packages/shared/package.json ./packages/shared/
COPY --from=builder --chown=node:node app/packages/shared/dist ./packages/shared/dist/

EXPOSE 4000

CMD ["node", "apps/backend/dist/main.js"]
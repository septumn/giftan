# ==============================================================================
# ENVIRONMENT CONFIGURATION (Server-side only)
# ==============================================================================
NODE_ENV=development

# ==============================================================================
# BACKEND INTEGRATION
# ==============================================================================
# The URL of your Nest.js backend
NEST_API_URL=http://localhost:4000

# GraphQL URL for Apollo Client
NEST_GRAPHQL_URL=http://localhost:4000/graphql

# ==============================================================================
# STORAGE & MEDIA CONFIGURATION
# ==============================================================================
# Public URL for fetching uploaded user avatars in the browser
NEXT_PUBLIC_AVATARS_URL=http://localhost:9000/avatars

# MinIO Server credentials (Keep secret, server-side only)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=